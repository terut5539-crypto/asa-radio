// daily_episodes.json を読み、各エピソードのノートを作成+ソース投入 → notebook_urls.txt を書く。
// 音声生成はしない（＝枠を消費しない）。固定プロファイル1つ・複製しない。
import path from 'node:path';
import fs from 'node:fs';
import { execSync } from 'node:child_process';
const NM = '/Users/hainodaiki/.npm/_npx/0d29dd9f4e472da9/node_modules';
const { chromium } = await import(path.join(NM, 'patchright', 'index.mjs')).catch(() => import(path.join(NM, 'patchright', 'index.js')));
const PROFILE = '/Users/hainodaiki/Library/Application Support/notebooklm-mcp/chrome_profile';
const FEED = '/Users/hainodaiki/asa-radio-feed';
const DIALOG = '.mat-mdc-dialog-container';
const log = (...a) => console.log(new Date().toISOString().slice(11,19), ...a);
const eps = JSON.parse(fs.readFileSync(path.join(FEED, 'daily_episodes.json'), 'utf8'));
if (!eps.length) { log('daily_episodes.json が空。何もしない'); process.exit(0); }

// 起動が180秒タイムアウトする持病対策: 掃除して最大3回リトライ。操作ロジックは不変。
const LAUNCH_OPTS = { headless: true, channel: 'chrome', viewport:{width:1500,height:950}, args: ['--no-first-run','--no-default-browser-check'], timeout: 90000 };
function cleanupProfile(){ try { execSync(`pkill -f "notebooklm-mcp/chrome_profile" 2>/dev/null; rm -f "${PROFILE}/Singleton"* 2>/dev/null`, {stdio:'ignore'}); } catch(e){} }
async function launchCtx(opts){
  for (let t=0; t<3; t++){
    try { return await chromium.launchPersistentContext(PROFILE, opts); }
    catch(e){ log('launch retry', t+1, e.message.slice(0,40)); cleanupProfile(); await new Promise(r=>setTimeout(r, 5000)); }
  }
  return await chromium.launchPersistentContext(PROFILE, {...opts, timeout: 150000}); // 最終試行(失敗ならthrow→シェルが次枠でリトライ)
}
const ctx = await launchCtx(LAUNCH_OPTS);
const page = ctx.pages()[0] || await ctx.newPage();
const count = () => page.evaluate(() => document.querySelectorAll('.single-source-container').length);
async function addSource(url) {
  const before = await count();
  const open = await page.locator(DIALOG).first().isVisible({ timeout: 2000 }).catch(()=>false);
  if (!open) { await page.locator('button.add-source-button').first().click({ timeout: 8000 }); await page.locator(DIALOG).first().waitFor({ state:'visible', timeout: 8000 }); }
  await page.locator(`${DIALOG} button.drop-zone-icon-button:has(mat-icon:text-is("link")), ${DIALOG} button.drop-zone-icon-button:has-text("ウェブサイト"), ${DIALOG} button.drop-zone-icon-button:has-text("Website")`).first().click({ timeout: 6000 });
  await page.waitForTimeout(1000);
  const inp = page.locator(`${DIALOG} input[type="text"]:not([readonly]), ${DIALOG} input[type="url"], ${DIALOG} textarea`).first();
  await inp.waitFor({ state:'visible', timeout: 6000 }); await inp.fill(url); await page.waitForTimeout(400);
  await page.locator(`${DIALOG} button.mdc-button--raised:has-text("挿入"), ${DIALOG} button:has-text("挿入"), ${DIALOG} button.mdc-button--raised:has-text("Insert"), ${DIALOG} button:has-text("Insert")`).first().click({ timeout: 6000 });
  await page.waitForTimeout(15000);
  return (await count()) > before;
}
const urlsFile = path.join(FEED, 'notebook_urls.txt');
// 既存の行のうち「今日のエピソード」の分だけ残す（前日の行は捨てる）。
// 途中で失敗したエピソードだけを後から作り足せるようにするため、毎回の全消しはしない。
// （2026-07-31: 1本目だけ作成成功→以降シェル側が「今日の行がある」と見なして作成をスキップし、
//   2・3本目が丸ごと作られないまま1本/日で頭打ちになっていた）
const slugs = new Set(eps.map(e => e.slug));
const keep = (fs.existsSync(urlsFile) ? fs.readFileSync(urlsFile,'utf8').trim().split('\n') : [])
  .filter(l => l && slugs.has(l.split(' ')[0]));
fs.writeFileSync(urlsFile, keep.length ? keep.join('\n') + '\n' : '');
const done = new Set(keep.map(l => l.split(' ')[0]));
try {
  for (const ep of eps) {
    // 既にノートがある / 既に音声DL済み なら作らない（重複ノートを増やさない）
    if (done.has(ep.slug) || fs.existsSync(path.join(FEED, 'audio', ep.slug + '.m4a'))) { log('SKIP(既存)', ep.slug); continue; }
    try {
      log('CREATE', ep.slug);
      await page.goto('https://notebooklm.google.com/', { waitUntil:'domcontentloaded', timeout: 30000 });
      await page.waitForTimeout(4000);
      if (/accounts\.google|\/login/.test(page.url())) { log('LOGGED_OUT'); fs.appendFileSync(urlsFile, 'LOGGED_OUT\n'); break; }
      // オンボーディング等のモーダルが作成ボタンを塞ぐと click がタイムアウトするので、先に閉じる
      const dismissSel = 'button.dismiss-button, .mat-mdc-dialog-container button:has-text("始める"), [role=dialog] button:has-text("始める"), .mat-mdc-dialog-container button:has-text("Get started"), [role=dialog] button:has-text("Got it")';
      for (let i=0;i<3;i++){ const d = page.locator(dismissSel).first(); if (await d.isVisible({timeout:1200}).catch(()=>false)) { await d.click({timeout:4000}).catch(()=>{}); await page.waitForTimeout(1000); } else break; }
      await page.keyboard.press('Escape').catch(()=>{}); await page.waitForTimeout(500);
      await page.locator('button.create-new-button, button:has-text("Create new"), button:has-text("新規作成"), button:has-text("Create"), [aria-label*="Create" i], .create-new-button, .create-new-action-button, button.create-new-label-button, project-button-create button').first().click({ timeout: 8000 });
      await page.waitForURL(/\/notebook\/[0-9a-f-]{36}/i, { timeout: 20000 });
      await page.waitForTimeout(3500);
      const url = page.url().split('?')[0];
      let ok = 0;
      for (const s of ep.sources) { try { if (await addSource(s)) ok++; } catch(e){ log('  src fail', e.message.slice(0,30)); await page.keyboard.press('Escape').catch(()=>{}); await page.waitForTimeout(1000); } }
      log('  sources', ok, '/', ep.sources.length);
      if (ok >= 1) fs.appendFileSync(urlsFile, `${ep.slug} ${url}\n`);
    } catch(e){ log('  EP ERR', e.message.slice(0,50)); }
  }
} catch(e){ log('FATAL', e.message); } finally { await ctx.close(); }
log('DONE notebook_urls.txt:', fs.readFileSync(urlsFile,'utf8').trim().split('\n').filter(Boolean).length, '本');
