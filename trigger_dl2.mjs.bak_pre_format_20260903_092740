// 座標クリックで音声解説タイルを押す版。notebook_urls.txt の各ノートを トリガー→完成待ち→DL。
import path from 'node:path';
import fs from 'node:fs';
import { execSync } from 'node:child_process';
const NM = '/Users/hainodaiki/.npm/_npx/0d29dd9f4e472da9/node_modules';
const { chromium } = await import(path.join(NM, 'patchright', 'index.mjs')).catch(() => import(path.join(NM, 'patchright', 'index.js')));
const PROFILE = '/Users/hainodaiki/Library/Application Support/notebooklm-mcp/chrome_profile';
const AUDIO_DIR = '/Users/hainodaiki/asa-radio-feed/audio';
// 2026-07-26に用意したまま未配線だった全体方針プロンプト。カスタム欄（話数ごとの焦点は既に自動入力
// されている）に追記する。話数ごとの内容は上書きせず残す（2026-08-12 asa-radio-audit指摘で配線）。
const CUSTOM_PROMPT_PATH = '/Users/hainodaiki/asa-radio-feed/audio_custom_prompt.txt';
const CUSTOM_PROMPT = fs.existsSync(CUSTOM_PROMPT_PATH) ? fs.readFileSync(CUSTOM_PROMPT_PATH, 'utf8').trim() : '';
const log = (...a) => console.log(new Date().toISOString().slice(11,19), ...a);
const urls0 = fs.readFileSync('/Users/hainodaiki/asa-radio-feed/notebook_urls.txt','utf8').trim().split('\n').filter(Boolean).map(l=>{const [slug,url]=l.split(' ');return {slug,url};});
// GEN_LIMIT: 夕方帯は1本だけ生成する等、無料枠の消費本数を呼び出し側から絞るため（枠解放時刻の後ろズレ防止）。
const GEN_LIMIT = parseInt(process.env.GEN_LIMIT || '0', 10);
// 先にDL済みを除いてから絞る。除かずに slice すると「1本だけ」の枠を
// DL済みエピソードが占有して、その日は何も生成されないまま終わる（2026-07-30）。
const pending = urls0.filter(u => !fs.existsSync(path.join(AUDIO_DIR, u.slug + '.m4a')));
const urls = GEN_LIMIT > 0 ? pending.slice(0, GEN_LIMIT) : pending;
log('targets:', urls.map(u=>u.slug).join(',') + (GEN_LIMIT>0 ? ` (GEN_LIMIT=${GEN_LIMIT} / 全${urls0.length})` : ''));
// 起動タイムアウト持病対策: 掃除して最大3回リトライ。操作ロジックは不変。
const LAUNCH_OPTS = { headless: true, channel: 'chrome', viewport:{width:1500,height:950}, acceptDownloads: true, args: ['--no-first-run'], timeout: 90000 };
function cleanupProfile(){ try { execSync(`pkill -f "notebooklm-mcp/chrome_profile" 2>/dev/null; rm -f "${PROFILE}/Singleton"* 2>/dev/null`, {stdio:'ignore'}); } catch(e){} }
async function launchCtx(opts){
  for (let t=0; t<3; t++){
    try { return await chromium.launchPersistentContext(PROFILE, opts); }
    catch(e){ log('launch retry', t+1, e.message.slice(0,40)); cleanupProfile(); await new Promise(r=>setTimeout(r, 5000)); }
  }
  return await chromium.launchPersistentContext(PROFILE, {...opts, timeout: 150000});
}
const ctx = await launchCtx(LAUNCH_OPTS);
const page = ctx.pages()[0] || await ctx.newPage();
const genstate = () => page.evaluate(()=>/生成しています|生成中|Generating/i.test((document.querySelector('studio-panel')||document.body).innerText||''));
const audioBox = () => page.evaluate(()=>{
  const ic=[...document.querySelectorAll('mat-icon')].find(m=>(m.textContent||'').trim()==='audio_magic_eraser');
  const el=ic&&ic.closest('.create-artifact-button-container');
  if(!el) return null; const r=el.getBoundingClientRect(); return {x:r.x+r.width/2,y:r.y+r.height/2,w:r.width};
});
// 「音声解説をカスタマイズ」ダイアログが出ていたら「生成」を押す（2026-08-07 のUI変更対応）
// patchrightは日本語の :has-text が効かないことがあるため、タイルと同じくDOM探索＋座標クリックで押す。
async function confirmGenerate(){
  const hasDlg = await page.evaluate(()=>{
    return !![...document.querySelectorAll('[role=dialog],.mat-mdc-dialog-container')]
      .find(d=>/音声解説をカスタマイズ|Customize (the )?Audio/i.test(d.innerText||''));
  });
  if(!hasDlg){ return false; }                          // ダイアログ自体が無い＝旧UI
  // カスタム欄（話数ごとの焦点は自動入力済み）に、全体方針プロンプトを追記する。
  if (CUSTOM_PROMPT) {
    const filled = await page.evaluate((extra)=>{
      const dlg=[...document.querySelectorAll('[role=dialog],.mat-mdc-dialog-container')]
        .find(d=>/音声解説をカスタマイズ|Customize (the )?Audio/i.test(d.innerText||''));
      const ta = dlg && dlg.querySelector('textarea');
      if (!ta) return false;
      const cur = ta.value || '';
      const setter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, 'value').set;
      setter.call(ta, cur ? (cur + '\n\n' + extra) : extra);
      ta.dispatchEvent(new Event('input', {bubbles:true}));
      ta.dispatchEvent(new Event('change', {bubbles:true}));
      return true;
    }, CUSTOM_PROMPT);
    log('confirm dialog: カスタム欄' + (filled ? 'に方針を追記' : 'のtextareaが見つからない'));
    await page.waitForTimeout(500);
  }
  const b = await page.evaluate(()=>{
    const dlg=[...document.querySelectorAll('[role=dialog],.mat-mdc-dialog-container')]
      .find(d=>/音声解説をカスタマイズ|Customize (the )?Audio/i.test(d.innerText||''));
    if(!dlg) return null;
    const btn=[...dlg.querySelectorAll('button')]
      .find(e=>{const t=(e.innerText||'').trim(); return t==='生成'||t==='Generate';});
    if(!btn) return {noBtn:true};
    const r=btn.getBoundingClientRect();
    return {x:r.x+r.width/2, y:r.y+r.height/2, w:r.width};
  });
  if(!b){ return false; }
  if(b.noBtn){ log('confirm dialog: 生成ボタンが見つからない'); return false; }
  await page.mouse.click(b.x, b.y);                    // ①座標クリック
  await page.waitForTimeout(3000);
  if(await genstate()){ log('confirm dialog: 生成 clicked(mouse)'); return true; }
  await page.evaluate(()=>{                            // ②JSで直接click
    const dlg=[...document.querySelectorAll('[role=dialog],.mat-mdc-dialog-container')]
      .find(d=>/音声解説をカスタマイズ|Customize (the )?Audio/i.test(d.innerText||''));
    const btn=dlg&&[...dlg.querySelectorAll('button')]
      .find(e=>{const t=(e.innerText||'').trim(); return t==='生成'||t==='Generate';});
    btn&&btn.click();
  });
  log('confirm dialog: 生成 clicked(js)');
  return true;
}
async function trigger(u){
  for(let t=0;t<4;t++){
    await page.goto(u.url,{waitUntil:'domcontentloaded',timeout:40000});
    await page.waitForTimeout(t===0?30000:15000);
    if(/accounts\.google|\/login/.test(page.url())){u.err='LOGGED_OUT';return false;}
    await page.keyboard.press('Escape').catch(()=>{});
    // Gemini Notebookリブランドの「始める」モーダル等が音声解説タイルを塞ぐので閉じる
    // （create_notebooks.mjs と同じ処理。2026-08-07 に trigger 側へも追加＝box null の真因）
    const dismissSel = 'button.dismiss-button, .mat-mdc-dialog-container button:has-text("始める"), [role=dialog] button:has-text("始める"), .mat-mdc-dialog-container button:has-text("Get started"), [role=dialog] button:has-text("Got it")';
    for (let i=0;i<3;i++){
      const d = page.locator(dismissSel).first();
      if (await d.isVisible({timeout:1200}).catch(()=>false)) { await d.click({timeout:4000}).catch(()=>{}); await page.waitForTimeout(1000); }
      else break;
    }
    const box=await audioBox();
    if(!box){ log(u.slug,'box null try',t); continue; }
    // ①実マウスで中心クリック
    await page.mouse.click(box.x, box.y);
    await page.waitForTimeout(5000);
    // 2026-08-07 UI変更: タイルを押すと「音声解説をカスタマイズ」ダイアログが開くようになり、
    // 右下の「生成」を押さないと開始しない（以前は即生成）。これが no gen の真因。
    if(await confirmGenerate()) { await page.waitForTimeout(4000); }
    if(await genstate()){ log(u.slug,'triggered(mouse)'); return true; }
    // ②JSで直接click
    await page.evaluate(()=>{const ic=[...document.querySelectorAll('mat-icon')].find(m=>(m.textContent||'').trim()==='audio_magic_eraser');const el=ic&&ic.closest('.create-artifact-button-container');el&&el.click();});
    await page.waitForTimeout(5000);
    if(await genstate()){ log(u.slug,'triggered(js)'); return true; }
    log(u.slug,'no gen try',t,'box.w='+Math.round(box.w));
  }
  u.err='TRIGGER_FAILED'; return false;
}
async function download(u){
  for(let i=0;i<30;i++){ await page.goto(u.url,{waitUntil:'domcontentloaded',timeout:40000}); await page.waitForTimeout(6000); if(!(await genstate()))break; await page.waitForTimeout(30000); }
  try{
    // 2026-08-09: patchrightは :has()/:text-is()/:has-text() が効かないことがあるため、
    // タイル・生成ボタンと同じく「DOM探索＋座標クリック」に統一。
    // ★重要: 画面には more_vert が9個ある（ソース一覧にもある）。「再生」ボタンと同じ行の
    //   more_vert だけが音声アイテムのメニュー。ここを絞らないとソースの削除メニューを開いてしまう。
    const mv=await page.evaluate(()=>{
      const plays=[...document.querySelectorAll('button,[role=button]')]
        .filter(e=>{const a=e.getAttribute('aria-label')||''; return (a==='再生'||a==='Play')&&e.getBoundingClientRect().width>0;});
      if(!plays.length) return null;
      const py=plays[0].getBoundingClientRect().top;
      const b=[...document.querySelectorAll('button,[role=button]')].find(e=>{
        const ic=[...e.querySelectorAll('mat-icon')].some(m=>(m.textContent||'').trim()==='more_vert');
        const r=e.getBoundingClientRect();
        return ic && r.width>0 && Math.abs(r.top-py)<10;
      });
      if(!b) return null;
      const r=b.getBoundingClientRect();
      return {x:r.x+r.width/2, y:r.y+r.height/2};
    });
    if(!mv) throw new Error('音声アイテムのmore_vertが無い(生成未完了?)');
    await page.mouse.click(mv.x, mv.y); await page.waitForTimeout(2000);
    const item=await page.evaluate(()=>{
      const panels=[...document.querySelectorAll('[role=menu],.mat-mdc-menu-panel,.cdk-overlay-pane')]
        .filter(e=>e.getBoundingClientRect().width>0);
      for(const p of panels){
        const el=[...p.querySelectorAll('[role=menuitem],button,.mat-mdc-menu-item')]
          .find(e=>/ダウンロード|Download|save_alt/.test(e.innerText||'') && e.getBoundingClientRect().width>0);
        if(el){ const r=el.getBoundingClientRect(); return {x:r.x+r.width/2, y:r.y+r.height/2}; }
      }
      return null;
    });
    if(!item) throw new Error('メニューにダウンロードが無い');
    const dest=path.join(AUDIO_DIR,u.slug+'.m4a');
    // ★2026-08-09: ダウンロードは「新しいポップアップページ」で発生する。
    //   page.waitForEvent('download') は元ページを見ているので永久に発火しない（90秒Timeoutの真因）。
    //   コンテキスト側で待つこと。
    const [dl]=await Promise.all([ ctx.waitForEvent('download',{timeout:120000}), page.mouse.click(item.x, item.y) ]);
    await dl.saveAs(dest); u.file=dest; u.size=fs.statSync(dest).size; log(u.slug,'DOWNLOADED',u.size);
  }catch(e){ u.err=(u.err||'')+'|DL:'+e.message.slice(0,40); log(u.slug,'DL fail',e.message.slice(0,40)); }
}
try{
  // 既にDL済みのエピソードはスキップ（枠の無駄食い・再生成を防ぐ）
  for(const u of urls){ if(fs.existsSync(path.join(AUDIO_DIR,u.slug+'.m4a'))){ u.file=path.join(AUDIO_DIR,u.slug+'.m4a'); u.skip=true; log(u.slug,'既にDL済み→スキップ'); } }
  // 無料枠は音声を「同時1本ずつ」しか生成できない（生成中は他ノートのタイルが無反応/非表示）。
  // よって 3本連続トリガーせず、1本ずつ「トリガー→生成完了を待ってDL→次」と直列化する。
  for(const u of urls){
    if(u.skip) continue;
    const ok = await trigger(u);
    if(ok) await download(u);   // download() は genstate が消える=生成完了まで待ってから落とす
  }
}catch(e){ log('FATAL',e.message); } finally { await ctx.close(); }
fs.writeFileSync('/Users/hainodaiki/asa-radio-feed/trigger_dl_result.json', JSON.stringify(urls,null,2));
log('DONE', JSON.stringify(urls.map(u=>({s:u.slug,ok:!!u.file,err:u.err}))));
